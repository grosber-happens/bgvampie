{
  "name": "vampire-battleground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "pnpm run typecheck && vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babylonjs/core": "9.32.0",
    "@babylonjs/loaders": "9.32.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
